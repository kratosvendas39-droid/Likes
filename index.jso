require('dotenv').config()
const {
    default: makeWASocket,
    useMultiFileAuthState,
    DisconnectReason,
    fetchLatestBaileysVersion
} = require('@whiskeysockets/baileys')
const { Boom } = require('@hapi/boom')
const P = require('pino')
const fs = require('fs')
const axios = require('axios')

// ================= CONFIGURAÇÕES =================
const DB_PATH = './database.json'
const NomeDoBot = 'KRATOS-STORE'
const NUMERO_CONEXAO = '556993543234' 
const DONOS = ['72950405451812', '556993543234', '277936125034703', '5551995588124', '44930357551239', '25701671538894']

const API_URL_LIKE = 'https://likesff.online/api/LIKE?key=LIKESFF-KLFF-KRATOSLIKESEPASSES&id='
const API_URL_PASS = 'https://likesff.online/api/PASS?key=LIKESFF-KLFF-KRATOSLIKESEPASSES&id=' 
const API_CHECK = 'https://likesff-info.squareweb.app/check_basic?id='

const TEMAS = {
    kratos: { 
        nome: 'KRATOS', 
        emoji: '⚔️', 
        foto: './kratos.jpg', 
        contato: '5551995588124',
        precos: { unitario: '0,50', pacote10: '4,00', pacote30: '10,00', pacote100: '25,00', suporte: 'wa.me/5551995588124' }
    },
    princesa: { 
        nome: 'PRINCESA', 
        emoji: '👑', 
        foto: './princesa.jpg', 
        contato: '5517996172795',
        precos: { unitario: '0,50', pacote10: '4,00', pacote30: '10,00', pacote100: '25,00', suporte: 'wa.me/5517996172795' }
    },
    zxguild: { 
        nome: 'ZXGUILD', 
        emoji: '⚡', 
        foto: './zxguild.jpg', 
        contato: '5551995588124',
        precos: { unitario: '0,50', pacote10: '4,00', pacote30: '10,00', pacote100: '25,00', suporte: 'wa.me/5551995588124' }
    },
    dark: { 
        nome: 'DARK7X VENDAS', 
        emoji: '🙅🏻‍♂️', 
        foto: './dark.jpg', 
        contato: '559181577964',
        precos: { unitario: '0,50', pacote10: '4,00', pacote30: '10,00', pacote100: '25,00', suporte: 'wa.me/559181577964' }
    }
}


// ================= DATABASE =================
const getDB = () => {
    const initial = { grupos: {}, vips: {}, passes: {} }
    try {
        return fs.existsSync(DB_PATH) ? JSON.parse(fs.readFileSync(DB_PATH, 'utf8')) : initial
    } catch { return initial }
}
const saveDB = (db) => fs.writeFileSync(DB_PATH, JSON.stringify(db, null, 2))

// ================= BOT CORE =================
async function startBot() {
    const { state, saveCreds } = await useMultiFileAuthState('./auth_sessao')
    const { version } = await fetchLatestBaileysVersion()

    const sock = makeWASocket({
        auth: state,
        version,
        logger: P({ level: 'silent' }),
        browser: ["Mac OS", "Chrome", "10.15.7"],
        printQRInTerminal: false,
        keepAliveIntervalMs: 30000,
        connectTimeoutMs: 60000
    })

    if (!sock.authState.creds.registered) {
        console.log(`\n⚙️ [${NomeDoBot}] Solicitando código para: +${NUMERO_CONEXAO}...`)
        
        setTimeout(async () => {
            try {
                let code = await sock.requestPairingCode(NUMERO_CONEXAO)
                code = code?.match(/.{1,4}/g)?.join('-') || code
                
                console.log(`\n============================================`)
                console.log(`   ⚔️  CONEXÃO VIA CÓDIGO DO ${NomeDoBot}  ⚔️   `)
                console.log(`============================================`)
                console.log(`  📱 Número do Bot: +${NUMERO_CONEXAO}`)
                console.log(`  🔑 SEU CÓDIGO DE CONEXÃO: \x1b[32m${code}\x1b[0m`)
                console.log(`============================================`)
                console.log(`  📌 No celular com o chip do Bot:`)
                console.log(`  1. Abra o WhatsApp -> Configurações`)
                console.log(`  2. Dispositivos conectados -> Conectar dispositivo`)
                console.log(`  3. Selecione "Conectar com número de telefone"`)
                console.log(`  4. Digite esse código verde acima!`)
                console.log(`============================================\n`)
            } catch (err) { 
                console.log('❌ Erro ao gerar o código:', err.message) 
            }
        }, 4000)
    }

    sock.ev.on('creds.update', saveCreds)

    sock.ev.on('connection.update', (update) => {
        const { connection, lastDisconnect } = update
        
        if (connection === 'connecting') {
            console.log(`📡 Conectando ao WhatsApp...`)
        }
        
        if (connection === 'open') {
            console.log(`✅ ${NomeDoBot} CONECTADO COM SUCESSO E ONLINE!`)
        }
        
        if (connection === 'close') {
            const statusCode = (lastDisconnect?.error instanceof Boom) ? lastDisconnect.error.output.statusCode : 0
            
            if (statusCode === DisconnectReason.loggedOut || statusCode === 401) {
                console.log(`⚠️ Sessão inválida (Código ${statusCode}). Limpando cache para novo código...`)
                if (fs.existsSync('./auth_sessao')) {
                    fs.rmSync('./auth_sessao', { recursive: true, force: true })
                }
                setTimeout(() => startBot(), 3000)
            } else {
                console.log(`❌ Conexão fechada. Código: ${statusCode}. Reiniciando em 5 segundos...`)
                setTimeout(() => startBot(), 5000)
            }
        }
    })

    sock.ev.on('messages.upsert', async ({ messages }) => {
        try {
            const msg = messages[0]
            if (!msg.message || msg.key.fromMe) return

            // ================= DEFINIÇÃO DE VARIÁVEIS COMPLEMENTARES =================
            const from = msg.key.remoteJid
            const isGroup = from.endsWith('@g.us')
            const body = (msg.message.conversation || msg.message.extendedTextMessage?.text || '').trim()
            const sender = (isGroup ? (msg.key.participant || from) : from).replace(/\D/g, '')

            const db = getDB()
            const isDono = DONOS.includes(sender)
            const isVip = isDono || (db.vips[sender] && (db.vips[sender].ids || 0) > 0)

            if (isGroup && !db.grupos[from]) {
                db.grupos[from] = { tema: 'kratos', publico: true, antilink: true }
                saveDB(db)
            }
            const grupo = isGroup ? db.grupos[from] : { tema: 'kratos', publico: true, antilink: false }
            const T = TEMAS[grupo.tema] || TEMAS.kratos

            // ====== SISTEMA DE VARREDURA ANTILINK ======
            if (isGroup && grupo.antilink && body) {
                if (body.match(/(https:\/\/chat\.whatsapp\.com)/gi) || body.match(/(https:\/\/wa\.me)/gi) || body.match(/www\./gi) || body.match(/\.com/gi)) {
                    const groupMetadata = await sock.groupMetadata(from)
                    const groupAdmins = groupMetadata.participants.filter(v => v.admin !== null).map(v => v.id.replace(/\D/g, ''))
                    const isSenderAdmin = groupAdmins.includes(sender)

                    if (!isSenderAdmin && !isDono) {
                        try {
                            await sock.sendMessage(from, { delete: msg.key })
                            return sock.sendMessage(from, { 
                                text: `🚫 *SISTEMA ANTILINK - ${T.nome}* 🚫\n\n⚠️ @${sender}, links não são permitidos neste reino! A sua mensagem foi banida e incinerada.`,
                                mentions: [sender + '@s.whatsapp.net']
                            })
                        } catch (err) {
                            console.log("Erro ao apagar link:", err)
                        }
                    }
                }
            }

            // Se não for um comando com barra, o bot ignora o restante das ações
            if (!body.startsWith('/')) return

            const args = body.slice(1).split(/ +/)
            const cmd = args.shift().toLowerCase()

            if (!isGroup && !isDono) {
                await sock.sendMessage(from, { text: "⚠️ *Aviso:* Olá! As interações e comandos deste bot estão desativadas no privado.\n\n📌 Para utilizá-lo, por favor, acesse o nosso grupo oficial da Kratos Store!" }, { quoted: msg });
                return;
            }

            const reply = async (text) => {
                const mentions = text.match(/@(\d+)/g)?.map(v => v.replace('@', '') + '@s.whatsapp.net')
                await sock.sendMessage(from, { text, mentions }, { quoted: msg })
            }

            switch (cmd) {
                case 'menu': {
                    const saldoUsuario = isDono ? 'INFINITO' : (db.vips[sender]?.ids || 0)
                    const statusUsuario = isDono ? 'DONO 👑' : (isVip ? 'VIP ⭐' : 'MEMBRO 👤')

                    let menuStr = `📜 *DECRETO REAL - ${T.nome}* 📜\n` +
                                  `  ⚜️ ━━━━━━━━━━━━━━━━━━ ⚜️\n\n` +
                                  `  👤 *Viajante:* @${sender}\n` +
                                  `  📊 *Classe:* ${statusUsuario}\n` +
                                  `  🎟️ *Poder VIP:* [ ${saldoUsuario} ]\n\n` +
                                  `  📜 *PERGAMINHO DE MAGIAS* 📜\n` +
                                  `  ⚡ _Envios & Consultas_ ⚡\n` +
                                  `  ⚔️ */like [id]* ➔ _Enviar likes ao perfil_\n` +
                                  `  🎟️ */pass [id]* ➔ _Gerar/Consultar passes_\n` +
                                  `  🔱 */vip* ➔ _Ver preços e recargas_\n\n` +
                                  `  🧠 _Artes Mentais (I.A)_ 🧠\n` +
                                  `  💬 */ia [pergunta]* ➔ _Oráculo Gemini_\n` +
                                  `  🎨 */criar [texto]* ➔ _Forjar imagem do além_\n` +
                                  `  🪄 */modificar [texto]* ➔ _Moldar foto marcada_\n\n` +
                                  `  🛡️ _Magias de Proteção_ 🛡️\n` +
                                  `  🔰 */antilink* ➔ _Status e controle de links_\n\n` +
                                  `  🔮 _Alquimia & Utilidades_ 🔮\n` +
                                  `  🎧 */play [nome]* ➔ _Invocar canções_\n` +
                                  `  📦 */sticker* ➔ _Transmutar em figurinha_`

                    const adminStr = `\n\n  👑 *COMANDOS DOS DEUSES* 👑\n` +
                                     `  🔓 */publico* ➔ _Liberar bot no reino_\n` +
                                     `  🔐 */privado* ➔ _Trancar para plebeus_\n` +
                                     `  🏢 */abrirgp* ➔ _Abrir os portões do grupo_\n` +
                                     `  🚷 */fechargp* ➔ _Fechar os portões_\n` +
                                     `  🛡️ */antilink [on/off]* ➔ _Trancar/Abrir barreira_\n` +
                                     `  ⭐ */addvip* ➔ _Conceder benção VIP_\n` +
                                     `  ❌ */delvip* ➔ _Banir privilégios_`

                    let fimPergaminho = `\n\n  ⚜️ ━━━━━━━━━━━━━━━━━━ ⚜️\n` +
                                        `📜 *FIM DO PERGAMINHO - ${T.emoji}* 📜`

                    const finalMenu = isDono ? (menuStr + adminStr + fimPergaminho) : (menuStr + fimPergaminho)

                    if (fs.existsSync(T.foto)) {
                        await sock.sendMessage(from, { 
                            image: fs.readFileSync(T.foto), 
                            caption: finalMenu,
                            mentions: [sender + '@s.whatsapp.net']
                        }, { quoted: msg })
                    } else { 
                        reply(finalMenu) 
                    }
                    break
                }

                case 'publico':
                    if (!isDono || !isGroup) return
                    db.grupos[from].publico = true; saveDB(db); reply('✅ Grupo PÚBLICO.')
                    break

                case 'privado':
                    if (!isDono || !isGroup) return
                    db.grupos[from].publico = false; saveDB(db); reply('🔒 Grupo PRIVADO.')
                    break

                case 'like': {
                    const idL = args[0]
                    if (!idL) return reply('❌ Informe o ID.')

                    if (!grupo.publico && !isVip) {
                        return reply("🔒 *ENVIO RESTRITO*\nApenas usuários VIP podem usar o comando de likes neste grupo privado.")
                    }

                    reply('⏳ Processando Likes...')
                    try {
                        const { data } = await axios.get(`${API_URL_LIKE}${idL}`)

                        let exibirVip = "GRÁTIS (MODO PÚBLICO)"
                        if (isDono) exibirVip = "INFINITO"
                        else if (isVip) exibirVip = (db.vips[sender].ids - 1)

                        if (data.status === "success" && !grupo.publico && !isDono && isVip) {
                            db.vips[sender].ids--
                        }

                        // ====== LÓGICA DO CONTADOR DIÁRIO ======
                        const dataHoje = new Date().toLocaleDateString('pt-BR')
                        if (!db.estatisticasDiarias || db.estatisticasDiarias.data !== dataHoje) {
                            db.estatisticasDiarias = { data: dataHoje, totalLikes: 0 }
                        }

                        if (data.status === "success") {
                            db.estatisticasDiarias.totalLikes++
                        }
                        saveDB(db)
                        // =======================================

                        const limiteDiario = 100
                        const usadosHoje = db.estatisticasDiarias.totalLikes
                        const modoGrupo = grupo.publico ? 'PÚBLICO 🔓' : 'PRIVADO 🔐'
                        const adicionado = data.status === "success" ? "SIM" : "NÃO"
                        const resultado = data.status === "success" ? "✅ Likes enviados com sucesso" : "❌ Falha no envio"

                        const painelLike = `🔥 *PAINEL LIKES - ${T.nome}* 🔥\n\n` +
                                           `👤 *Nick:* ${data.nickname || 'Não encontrado'}\n` +
                                           `🆔 *ID:* ${data.id}\n\n` +
                                           `📊 *Likes Antes:* ${data.likes_before || '0'}\n` +
                                           `✨ *Likes Adicionados:* ${data.likes_added || '0'}\n` +
                                           `🏆 *Likes Total:* ${data.likes_end || '0'}\n\n` +
                                           `🔑 *Envios Diários:* \n` +
                                           `${usadosHoje}/${limiteDiario}\n\n` +
                                           `⭐ *Envios Restantes (VIP):* ${exibirVip}\n` +
                                           `📥 *Key adicionada:* ${adicionado}\n\n` +
                                           `📢 *Status:* \n` +
                                           `${data.message || 'Sem mensagem da API'}\n` +
                                           `━━━━━━━━━━━━━━━\n\n` +
                                           `📡 *Resultado:* \n` +
                                           `${resultado}\n\n` +
                                           `🔐 *Modo:* ${modoGrupo}`

                        reply(painelLike)
                    } catch { reply('❌ Erro na API de Likes.') }
                    break
                }

                case 'pass': {
                    const idP = args[0]
                    if (!idP) return reply('❌ Informe o ID.')
                    
                    if (!grupo.publico && !isVip) {
                        return reply("🔒 *ENVIO RESTRITO*\nApenas usuários VIP podem enviar passes neste grupo privado.")
                    }

                    const saldoAtual = db.passes[sender] || 0
                    if (!isDono && saldoAtual <= 0) {
                        return reply('❌ Sem saldo de passes. Faça uma recarga!')
                    }

                    reply('⏳ Processando Passes...')
                    try {
                        const { data } = await axios.get(`${API_URL_PASS}${idP}`)
                        let saldoRestante = isDono ? "INFINITO" : (saldoAtual - 1)

                        if (data.status === "success" && !isDono) {
                            db.passes[sender]--
                            saveDB(db)
                        }
                        reply(`🎟️ *PAINEL PASSES*\n\n👤 Nick: ${data.nickname}\n🆔 ID: ${data.id}\n📦 Saldo de Passes: ${saldoRestante}\n📡 Status: ${data.message || 'Sucesso'}`)
                    } catch { reply('❌ Erro na API de Passes.') }
                    break
                }

                case 'check': {
                    const idC = args[0]
                    if (!idC) return reply('❌ Informe o ID.')
                    try {
                        const { data } = await axios.get(`${API_CHECK}${idC}`)
                        reply(`⚔️ *PAINEL CONSULTA*\n\n👤 Nick: ${data.nickname}\n🆔 ID: ${data.id}\n📊 Nível: ${data.level}\n❤️ Likes: ${data.likes_end || data.likes_before}\n⏰ Login: ${data.login_end_formatted}`)
                    } catch { reply('❌ Erro.') }
                    break
                }

                case 'tema': {
                    if (!isGroup) return
                    
                    const choice = args[0]?.toLowerCase()
                    if (!TEMAS[choice]) {
                        return reply(`🎨 *Opções de temas disponíveis:* \n• kratos\n• princesa\n• dark\n• zxguild`)
                    }
                    
                    db.grupos[from].tema = choice
                    saveDB(db)
                    
                    reply(`🎨 *Tema alterado com sucesso para:* ${choice.toUpperCase()}`)
                    break
                }

                case 'addvip': {
                    if (!isDono) return
                    let uV = msg.message.extendedTextMessage?.contextInfo?.mentionedJid?.[0] || args[0] || ''
                    uV = uV.replace('@s.whatsapp.net', '').replace(/\D/g, '')

                    if (!uV) return reply('❌ Marque o usuário ou informe o ID para adicionar como VIP.')
                    const qtdIds = parseInt(args[1]) || 10
                    db.vips[uV] = { ids: qtdIds }
                    saveDB(db)
                    reply(`⭐ *VIP ADICIONADO*\n\n👤 Usuário: @${uV}\n🔥 Limite de Envios: ${qtdIds}`)
                    break
                }

                case 'delvip': {
                    if (!isDono) return
                    let uD = msg.message.extendedTextMessage?.contextInfo?.mentionedJid?.[0] || args[0] || ''
                    uD = uD.replace('@s.whatsapp.net', '').replace(/\D/g, '')

                    if (!uD) return reply('❌ Marque o usuário ou informe o ID para remover.')
                    if (!db.vips[uD]) return reply(`💡 O usuário @${uD} não está na lista VIP.`)
                    
                    delete db.vips[uD]
                    saveDB(db)
                    reply(`✅ *VIP REMOVIDO*\n\n👤 Usuário: @${uD}\nVoltou a ser usuário Free!`)
                    break
                }
                
                case 'perfil': {
                    const cargo = isDono ? 'DONO 👑' : (isVip ? 'VIP ⭐' : 'USUÁRIO FREE 👤')
                    const saldoVip = isDono ? 'INFINITO' : (db.vips[sender]?.ids || 0)
                    const saldoPasses = db.passes[sender] || 0

                    reply(`👤 *SEU PERFIL - ${T.nome}* 👤\n\n📞 *Contato:* @${sender}\n🎖️ *Cargo:* ${cargo}\n\n━━━━━━━━━━━━━━━\n\n🔥 *Envios VIP (Likes):* ${saldoVip}\n🎟️ *Saldo de Passes:* ${saldoPasses}\n\n💡 _Use seu saldo para enviar likes ou fazer consultas via /like e /check._`)
                    break
                }

                case 'info': {
                    if (!isDono) return
                    const totalGrupos = Object.keys(db.grupos).length
                    const totalVips = Object.keys(db.vips).length
                    const modoAtual = isGroup ? (db.grupos[from].publico ? '🔓 PÚBLICO' : '🔒 PRIVADO') : 'N/A'

                    reply(`📊 *ESTATÍSTICAS DO SISTEMA*\n\n⚔️ *Bot:* ${NomeDoBot}\n👥 *Grupos Ativos:* ${totalGrupos}\n👑 *Usuários VIP:* ${totalVips}\n\n📍 *Este Grupo:*\n🛠️ *Configuração:* ${modoAtual}\n🎨 *Tema:* ${T.nome.toUpperCase()}\n\n📡 *Status:* Online e Operante`)
                    break
                }

                case 'ban': {
                    if (!isGroup) return reply('❌ Este comando só pode ser utilizado em grupos!')

                    const groupMetadata = await sock.groupMetadata(from)
                    const groupParticipants = groupMetadata.participants
                    const groupAdmins = groupParticipants.filter(v => v.admin !== null).map(v => v.id.replace(/\D/g, ''))
                    
                    const isSenderAdmin = groupAdmins.includes(sender)

                    if (!isSenderAdmin && !isDono) {
                        return reply('❌ Apenas administradores do grupo ou o dono do sistema podem usar este comando!')
                    }

                    let targetParticipant = null

                    const quotedMessage = msg.message.extendedTextMessage?.contextInfo
                    if (quotedMessage?.participant) {
                        targetParticipant = quotedMessage.participant
                    } 
                    else if (quotedMessage?.mentionedJid && quotedMessage.mentionedJid.length > 0) {
                        targetParticipant = quotedMessage.mentionedJid[0]
                    }

                    if (!targetParticipant) {
                        return reply('⚠️ Você precisa *marcar (@)* o usuário ou *responder* à mensagem dele para banir!')
                    }

                    try {
                        await sock.groupParticipantsUpdate(from, [targetParticipant], 'remove')
                        reply('👋 Usuário removido com sucesso do grupo!')
                    } catch (err) {
                        reply('❌ Erro ao tentar banir. Certifique-se de que eu sou administrador deste grupo!')
                    }
                    break
                }

                case 'vip': {
                    if (isVip || isDono) {
                        const statusVip = isDono ? 'DONO 👑' : 'CLIENTE ⭐'
                        const saldoVip = isDono ? 'INFINITO' : (db.vips[sender]?.ids || 0)
                        return reply(`🎟️ *STATUS - ${T.nome}*\n\n👤 *Usuário:* @${sender}\n📊 *Status:* ${statusVip}\n🔥 *Envios Restantes:* ${saldoVip}\n\n✅ Você ainda pode realizar ${saldoVip} envios de likes.`)
                    }

                    const p = T.precos || { unitario: '0,50', pacote10: '4,00', pacote30: '10,00', pacote100: '25,00', suporte: 'wa.me/5551995588124' }

                    const tabelaPrecos = `${T.emoji} *RECARGAS DE LIKES - ${T.nome}* ${T.emoji}\n\n` +
                                         `Adquira envios unitários para usar no bot agora mesmo!\n\n` +
                                         `🪙 *VALORES POR ENVIO:* \n\n` +
                                         `📌 *1 ENVIO UNITÁRIO*\n` +
                                         `• Valor: R$ ${p.unitario}\n\n` +
                                         `📌 *PACOTE 10 ENVIOS*\n` +
                                         `• Valor: R$ ${p.pacote10}\n\n` +
                                         `📌 *PACOTE 30 ENVIOS*\n` +
                                         `• Valor: R$ ${p.pacote30}\n\n` +
                                         `📌 *PACOTE 100 ENVIOS*\n` +
                                         `• Valor: R$ ${p.pacote100}\n\n` +
                                         `⚠️ *COMO RECARREGAR?*\n` +
                                         `📞 ${p.suporte}`

                    if (fs.existsSync('./tabela.jpg')) {
                        await sock.sendMessage(from, { image: fs.readFileSync('./tabela.jpg'), caption: tabelaPrecos }, { quoted: msg })
                    } else { 
                        reply(tabelaPrecos) 
                    }
                    break
                }

                case 'saldo': {
                    const numeroContato = T.contato || '5551995588124'

                    const tabelaSaldo = `💳 *TABELA DE SALDO PARA PASSES* 💳\n\n` +
                                        `🔥 *Passe Atual:*\n` +
                                        `• 1 Passe: *R$ 7,00*\n` +
                                        `• 2 Passes: *R$ 13,00*\n` +
                                        `• 3 Passes: *R$ 18,00*\n\n` +
                                        `⏳ *Passe Reserva:*\n` +
                                        `• 1 Passe: *R$ 6,00*\n` +
                                        `• 2 Passes: *R$ 10,50*\n` +
                                        `• 3 Passes: *R$ 15,00*\n\n` +
                                        `⚠️ *Aviso Importante:*\n` +
                                        `Para comprar, entre em contato somente com o criador do sistema!\n\n` +
                                        `📞 *Contato:*\n` +
                                        `• WhatsApp: wa.me/${numeroContato}`

                    reply(tabelaSaldo)
                    break
                }

                case 'clearlist': {
                    if (!isDono) return reply('❌ Apenas o dono pode resetar a lista.')
                    db.vips = {}
                    saveDB(db)
                    reply('⚠️ *LISTA VIP RESETADA!* ⚠️\nTodos os usuários VIP foram removidos.')
                    break
                }

                case 'abrirgp': {
                    if (!isGroup) return reply('❌ Este comando só funciona em grupos.')
                    const groupMetadata = await sock.groupMetadata(from)
                    const groupAdmins = groupMetadata.participants.filter(v => v.admin !== null).map(v => v.id.replace(/\D/g, ''))
                    if (!groupAdmins.includes(sender) && !isDono) return reply('❌ Apenas administradores podem usar este comando.')

                    await sock.groupSettingUpdate(from, 'not_announcement')
                    reply(`🔓 *GRUPO ABERTO - ${T.nome}*\n\nAgora todos os membros podem enviar mensagens novamente!`)
                    break
                }

                case 'fechargp': {
                    if (!isGroup) return reply('❌ Este comando só funciona em grupos.')
                    const groupMetadata = await sock.groupMetadata(from)
                    const groupAdmins = groupMetadata.participants.filter(v => v.admin !== null).map(v => v.id.replace(/\D/g, ''))
                    if (!groupAdmins.includes(sender) && !isDono) return reply('❌ Apenas administradores podem usar este comando.')

                    await sock.groupSettingUpdate(from, 'announcement')
                    reply(`🔒 *GRUPO FECHADO - ${T.nome}*\n\nGrupo fechado para suporte! Apenas administradores podem enviar mensagens.`)
                    break
                }

                case 'sticker':
                case 's': {
                    try {
                        const { downloadContentFromMessage } = require('@whiskeysockets/baileys')
                        const { exec } = require('child_process')
                        const path = require('path')
                        const fs = require('fs')

                        // Captura a mensagem direta ou a mensagem que foi marcada (quoted)
                        const quoted = msg.message?.extendedTextMessage?.contextInfo?.quotedMessage
                        const msgReal = quoted || msg.message

                        if (!msgReal) return reply('⚠️ Envie ou marque uma imagem, GIF ou vídeo curto!')

                        // Mapeia todas as possíveis origens de imagem e vídeo do WhatsApp (incluindo mídias temporárias/únicas)
                        const imgMessage = msgReal.imageMessage || msgReal.viewOnceMessage?.message?.imageMessage || msgReal.viewOnceMessageV2?.message?.imageMessage
                        const vidMessage = msgReal.videoMessage || msgReal.viewOnceMessage?.message?.videoMessage || msgReal.viewOnceMessageV2?.message?.videoMessage

                        if (!imgMessage && !vidMessage) {
                            return reply('⚠️ Você precisa *marcar ou enviar* uma imagem, GIF ou vídeo curto!')
                        }

                        reply('🔮 *Transmutando mídia em figurinha animada...* ⏳')

                        // Define os parâmetros de download com base no tipo real da mídia
                        const isAnimated = !!vidMessage
                        const tipoMidia = isAnimated ? 'video' : 'image'
                        const infoDownload = imgMessage || vidMessage

                        const stream = await downloadContentFromMessage(infoDownload, tipoMidia)
                        let buffer = Buffer.from([])
                        for await (const chunk of stream) {
                            buffer = Buffer.concat([buffer, chunk])
                        }

                        // Configura caminhos e extensões temporárias no Termux
                        const extEntrada = isAnimated ? 'mp4' : 'jpg'
                        const arquivoEntrada = path.join(process.cwd(), `temp_${sender}.${extEntrada}`)
                        const arquivoSaidaWebp = path.join(process.cwd(), `temp_${sender}.webp`)

                        fs.writeFileSync(arquivoEntrada, buffer)

                        let comandoFfmpeg = ''
                        if (!isAnimated) {
                            // Filtro estático: redimensiona e centraliza com fundo transparente
                            comandoFfmpeg = `ffmpeg -i "${arquivoEntrada}" -vcodec libwebp -filter_complex "scale='if(gt(a,1),512,-1)':'if(gt(a,1),-1,512)',pad=512:512:(512-iw)/2:(512-ih)/2:color=white@0" -y "${arquivoSaidaWebp}"`
                        } else {
                            // Filtro animado crucial: limita frames (-r 15), remove áudio (-an), força resolução e loop infinito (-loop 0)
                            comandoFfmpeg = `ffmpeg -i "${arquivoEntrada}" -vcodec libwebp -filter_complex "scale=512:512:flags=lanczos" -r 15 -loop 0 -an -vsync 0 -preset default -y "${arquivoSaidaWebp}"`
                        }

                        exec(comandoFfmpeg, async (erro) => {
                            if (erro) {
                                console.log("Erro no FFmpeg:", erro)
                                reply('❌ O formato deste GIF/Vídeo não é suportado pelo codificador local.')
                                if (fs.existsSync(arquivoEntrada)) fs.unlinkSync(arquivoEntrada)
                                return
                            }

                            if (!fs.existsSync(arquivoSaidaWebp)) {
                                if (fs.existsSync(arquivoEntrada)) fs.unlinkSync(arquivoEntrada)
                                return reply('❌ Falha ao processar o arquivo final da animação.')
                            }

                            // Envia a figurinha (estática ou em loop animado) diretamente no chat
                            await sock.sendMessage(from, { sticker: fs.readFileSync(arquivoSaidaWebp) }, { quoted: msg })

                            // Limpeza automática de lixo do sistema do celular
                            if (fs.existsSync(arquivoEntrada)) fs.unlinkSync(arquivoEntrada)
                            if (fs.existsSync(arquivoSaidaWebp)) fs.unlinkSync(arquivoSaidaWebp)
                        })

                    } catch (err) {
                        console.log("Erro estrutural sticker:", err)
                        reply('❌ Erro inesperado ao criar a figurinha.')
                    }
                    break
                }

                case 'play': {
                    const busca = args.join(' ')
                    if (!busca) return reply('❌ Digite o nome da música ou do artista.')
                    
                    reply('🎵 *Buscando música no YouTube...* ⏳')
                    try {
                        const yts = require('yt-search')
                        const { exec } = require('child_process')
                        const path = require('path')
                        const fs = require('fs')
                        
                        // Faz a busca rápida do vídeo
                        const resultadoBusca = await yts(busca)
                        const videos = resultadoBusca.videos

                        if (!videos || videos.length === 0) {
                            return reply('❌ Nenhuma música encontrada com esse nome.')
                        }

                        const primeiroVideo = videos[0]
                        const urlDoVideo = primeiroVideo.url
                        const titulo = primeiroVideo.title

                        reply(`🎶 *Música:* _${titulo}_\n📥 *Baixando e extraindo áudio localmente...*`)

                        // Nome temporário único para o arquivo usando o ID do usuário
                        const saidaAudio = path.join(process.cwd(), `audio_${sender}`)

                        // Comando yt-dlp otimizado para burlar bloqueios fingindo ser um cliente Android
                        const comando = `yt-dlp -f "ba/best" --extract-audio --audio-format mp3 --audio-quality 192K --no-playlist --no-warnings --extractor-args "youtube:player_client=android" -o "${saidaAudio}.%(ext)s" "${urlDoVideo}"`

                        exec(comando, async (erro, stdout, stderr) => {
                            const arquivoFinal = `${saidaAudio}.mp3`

                            if (erro) {
                                console.log("Erro no yt-dlp:", stderr || erro.message)
                                return reply('❌ O YouTube bloqueou a requisição local. Tente novamente mais tarde.')
                            }

                            if (!fs.existsSync(arquivoFinal)) {
                                return reply('❌ Erro ao localizar o arquivo de áudio convertido.')
                            }

                            // Envia o áudio limpo direto para o chat do cliente
                            await sock.sendMessage(from, { 
                                audio: fs.readFileSync(arquivoFinal), 
                                mimetype: 'audio/mp4', 
                                ptt: false 
                            }, { quoted: msg })

                            // Limpa o arquivo temporário do celular para poupar memória
                            if (fs.existsSync(arquivoFinal)) fs.unlinkSync(arquivoFinal)
                        })

                    } catch (error) { 
                        console.log("Erro geral no comando play:", error.message)
                        reply('❌ Erro no processamento interno do comando.') 
                    }
                    break
                }

                case 'ia': {
                    const pergunta = args.join(' ')
                    if (!pergunta) return reply('❌ Por favor, digite uma pergunta para a IA.\n\n📌 Exemplo: */ia crie um texto de vendas para o grupo*')

                    reply('🤖 *Kratos IA está processando...* ⏳')
                    try {
                        const GEMINI_API_KEY = 'AIzaSyD7zlHbgOxwA-El2DLmbmYsTuzc4Bw2lK8' 
                        const urlGemini = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${GEMINI_API_KEY}`

                        const corpoDados = {
                            contents: [{
                                parts: [{
                                    text: pergunta
                                }]
                            }]
                        }

                        const { data } = await axios.post(urlGemini, corpoDados, {
                            headers: { 'Content-Type': 'application/json' }
                        })

                        const respostaIA = data.candidates?.[0]?.content?.parts?.[0]?.text || 'Não consegui formular uma resposta.'

                        const layoutIA = `🤖 *ASSISTENTE GEMINI - ${T.nome}* 🤖\n\n` +
                                         `💬 *Pergunta:* _${pergunta}_\n\n` +
                                         `💡 *Resposta:*\n${respostaIA.trim()}\n\n` +
                                         `━━━━━━━━━━━━━━━\n` +
                                         `⚙️ _Tecnologia Gemini 3 Flash_`

                        reply(layoutIA)
                    } catch (err) {
                        reply('❌ Erro ao processar o seu pedido com a IA. Tente novamente mais tarde.')
                    }
                    break
                }

                case 'criar': {
                    const prompt = args.join(' ')
                    if (!prompt) return reply('❌ Descreva a imagem que deseja gerar.\n\n📌 Exemplo: */criar um guerreiro espartano no estilo anime cyberpunk*')

                    reply('🎨 *O Gemini está desenhando a sua imagem...* ⏳')
                    try {
                        const GEMINI_API_KEY = 'AIzaSyD7zlHbgOxwA-El2DLmbmYsTuzc4Bw2lK8'
                        const urlGeminiImage = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-image:generateImages?key=${GEMINI_API_KEY}`

                        const corpoDados = {
                            prompt: prompt,
                            numberOfImages: 1,
                            outputMimeType: "image/jpeg",
                            aspectRatio: "1:1"
                        }

                        const { data } = await axios.post(urlGeminiImage, corpoDados, {
                            headers: { 'Content-Type': 'application/json' }
                        })

                        const base64Image = data.generatedImages?.[0]?.image?.imageBytes
                        if (!base64Image) return reply('❌ A IA não conseguiu gerar esta imagem. Tente usar outros termos descritivos.')

                        const bufferImg = Buffer.from(base64Image, 'base64')
                        await sock.sendMessage(from, { 
                            image: bufferImg, 
                            caption: `🎨 *IMAGEM GERADA - ${T.nome}*\n\n✨ *Prompt:* _${prompt}_\n🤖 _Modelo: Gemini 3 Flash Image_` 
                        }, { quoted: msg })
                    } catch (err) {
                        reply('❌ Erro ao processar imagem. Verifique se o prompt não viola os termos de segurança da API.')
                    }
                    break
                }

                case 'modificar': {
                    const promptAlteracao = args.join(' ')
                    const type = msg.message.extendedTextMessage?.contextInfo?.quotedMessage ? Object.keys(msg.message.extendedTextMessage.contextInfo.quotedMessage)[0] : Object.keys(msg.message)[0]
                    const isQuotedImage = type === 'imageMessage' || (type === 'extendedTextMessage' && msg.message.extendedTextMessage.contextInfo.quotedMessage?.imageMessage)

                    if (!isQuotedImage && type !== 'imageMessage') {
                        return reply('⚠️ Você precisa *marcar uma imagem* ou enviar uma foto junta e digitar o comando para modificá-la!\n\n📌 Exemplo: */modificar adicione asas de fogo azuis*')
                    }
                    if (!promptAlteracao) return reply('❌ Diga o que a IA deve alterar ou adicionar na imagem.')

                    reply('🪄 *A IA Nano Banana Pro está editando a imagem...* ⏳')
                    try {
                        const { downloadContentFromMessage } = require('@whiskeysockets/baileys')
                        const GEMINI_API_KEY = 'AIzaSyD7zlHbgOxwA-El2DLmbmYsTuzc4Bw2lK8'
                        const urlPro = `https://generativelanguage.googleapis.com/v1beta/models/nano-banana-pro:editImage?key=${GEMINI_API_KEY}`

                        const imgMessage = msg.message.imageMessage || msg.message.extendedTextMessage.contextInfo.quotedMessage.imageMessage
                        const stream = await downloadContentFromMessage(imgMessage, 'image')
                        let buffer = Buffer.from([])
                        for await (const chunk of stream) { buffer = Buffer.concat([buffer, chunk]) }

                        const base64Original = buffer.toString('base64')

                        const corpoDados = {
                            prompt: promptAlteracao,
                            image: { imageBytes: base64Original },
                            numberOfImages: 1
                        }

                        const { data } = await axios.post(urlPro, corpoDados, {
                            headers: { 'Content-Type': 'application/json' }
                        })

                        const base64Modificada = data.generatedImages?.[0]?.image?.imageBytes
                        if (!base64Modificada) return reply('❌ Não foi possível modificar esta imagem.')

                        const bufferResultado = Buffer.from(base64Modificada, 'base64')
                        await sock.sendMessage(from, { 
                            image: bufferResultado, 
                            caption: `🪄 *IMAGEM MODIFICADA - ${T.nome}*\n\n✨ *Alteração:* _${promptAlteracao}_\n🤖 _Modelo: Nano Banana Pro (Composição e Estilo)_` 
                        }, { quoted: msg })
                    } catch (err) {
                        reply('❌ Erro ao tentar modificar a imagem via API.')
                    }
                    break
                }

                case 'antilink': {
                    if (!isGroup) return reply('❌ Este comando só pode ser executado dentro de um grupo.')
                    
                    const groupMetadata = await sock.groupMetadata(from)
                    const groupAdmins = groupMetadata.participants.filter(v => v.admin !== null).map(v => v.id.replace(/\D/g, ''))
                    if (!groupAdmins.includes(sender) && !isDono) return reply('❌ Apenas os administradores do grupo ou o dono do bot podem usar este decreto.')

                    if (!db.grupos) db.grupos = {}
                    if (!db.grupos[from]) db.grupos[from] = { antilink: false }

                    const parametro = args[0] ? args[0].toLowerCase() : ''

                    if (parametro === 'on' || parametro === 'ligar') {
                        db.grupos[from].antilink = true
                        saveDB(db)
                        reply(`🛡️ *ANTILINK ATIVADO - ${T.nome}* 🛡️\n\nOs portões foram trancados! Qualquer link enviado por membros comuns será apagado imediatamente.`)
                    } else if (parametro === 'off' || parametro === 'desligar') {
                        db.grupos[from].antilink = false
                        saveDB(db)
                        reply(`🔓 *ANTILINK DESATIVADO - ${T.nome}* 🔓\n\nOs portões foram abertos. O envio de links agora está tolerado no grupo.`)
                    } else {
                        const statusAtual = db.grupos[from].antilink ? 'ATIVADO 🛡️' : 'DESATIVADO 🔓'
                        reply(`🛡️ *CONFIGURAÇÃO ANTILINK* 🛡️\n\n📌 *Status Atual:* ${statusAtual}\n\n💡 _Para alterar use:_\n• */antilink on* (Para ligar)\n• */antilink off* (Para desligar)`)
                    }
                    break
                }

                case 'vips': {
                    const listaVips = Object.keys(db.vips || {})
                    const vipsAtivos = listaVips.filter(num => (db.vips[num].ids || 0) > 0)

                    if (vipsAtivos.length === 0) return reply("❌ *Nenhum usuário VIP cadastrado até o momento!*")

                    let textoVips = `⭐ *LISTA DE USUÁRIOS VIP - KRATOS STORE* ⭐\n\nTotal de VIPs ativos: *${vipsAtivos.length}*\n\n`
                    vipsAtivos.forEach((num, index) => {
                        const creditos = db.vips[num].ids || 0
                        textoVips += `${index + 1}. @${num} — *${creditos} IDs/Créditos*\n`
                    })

                    textoVips += `\n📌 _Para adquirir VIP ou consultar planos, fale com o suporte._`
                    return reply(textoVips)
                }
            }
        } catch (e) { console.log(e) }
    })
}

startBot().catch(err => console.log("Erro crítico na inicialização:", err))
